{
  "name": "boxsys-pdv-desktop",
  "productName": "Box Sys PDV",
  "version": "1.1.0",
  "description": "App desktop do Box Sys PDV — carrega o painel web e adiciona impressão térmica direta (sem diálogo do navegador).",
  "main": "src/main.js",
  "author": "BoxSys",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.7.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "br.com.boxsys.pdv",
    "productName": "Box Sys PDV",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://www.boxsys.com.br/downloads/pdv-updates/",
      "channel": "latest"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Box Sys-PDV-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "BoxSys-PDV-Portable.exe"
    }
  }
}
