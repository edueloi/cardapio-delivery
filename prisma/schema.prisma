generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  whatsapp    String?
  address     String?
  isOpen      Boolean  @default(true) @map("is_open")
  businessHours String? @map("business_hours") @db.Text // JSON: { mon: {open:"08:00",close:"22:00",enabled:true}, ... }
  deliveryConfig String? @map("delivery_config") @db.Text // JSON: DeliveryConfig
  paymentMethods String? @map("payment_methods") @db.Text // JSON: PaymentConfig
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users      User[]
  memberships TenantMembership[]
  categories Category[]
  products   Product[]
  orders     Order[]
  cashRegisters CashRegister[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  wppInstance WppInstance?
  wppBotConfig WppBotConfig?
  customers   Customer[]

  @@map("tenants")
}

model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships TenantMembership[]
  sessions    AuthSession[]

  @@map("accounts")
}

model TenantMembership {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  tenantId  String   @map("tenant_id")
  role      String   @default("OWNER") // OWNER, ADMIN, STAFF
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([accountId, tenantId])
  @@map("tenant_memberships")
}

model AuthSession {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model InventoryCategory {
  id        String   @id @default(cuid())
  name      String
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  items  InventoryItem[]

  @@map("inventory_categories")
}

model InventoryItem {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  categoryId      String?   @map("category_id")
  code            String?   // Product code
  name            String
  brand           String?   // Brand
  purchasePrice   Float?    @map("purchase_price")
  sellingPrice    Float?    @map("selling_price")
  quantity        Float     @default(0)
  minStock        Float?    @map("min_stock")
  unit            String?   // kg, g, un, cm, ml
  weight          String?   // Specific weight/measure e.g. "500g"
  usage           String    @default("SALE") @map("usage") // SALE (external), INTERNAL
  purchaseDate    DateTime? @map("purchase_date")
  expirationDate  DateTime? @map("expiration_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  category InventoryCategory? @relation(fields: [categoryId], references: [id])
  movements StockMovement[]
  products  Product[]
  variants  ProductVariant[]

  @@map("inventory_items")
}

model StockMovement {
  id          String   @id @default(cuid())
  itemId      String   @map("item_id")
  type        String   // IN, OUT
  quantity    Float
  reason      String?  // SALE, PURCHASE, EXPIRATION, LOSS, MANUAL
  orderId     String?  @map("order_id")
  createdAt   DateTime @default(now()) @map("created_at")

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

model CashRegister {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  openedAt        DateTime  @default(now()) @map("opened_at")
  closedAt        DateTime? @map("closed_at")
  openingBalance  Float     @map("opening_balance")
  closingBalance  Float?    @map("closing_balance")
  expectedBalance Float?    @map("expected_balance")
  status          String    @default("OPEN") // OPEN, CLOSED
  notes           String?
  operatorName    String?   @map("operator_name")

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  movements CashMovement[]

  @@map("cash_registers")
}

model CashMovement {
  id             String   @id @default(cuid())
  cashRegisterId String   @map("cash_register_id")
  tenantId       String   @map("tenant_id")
  type           String   // SANGRIA, SUPRIMENTO, PAYMENT_CASH, PAYMENT_PIX, PAYMENT_CREDIT, PAYMENT_DEBIT, PAYMENT_VR
  amount         Float
  description    String?
  orderId        String?  @map("order_id")
  operatorName   String?  @map("operator_name")
  createdAt      DateTime @default(now()) @map("created_at")

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)

  @@map("cash_movements")
}

model Customer {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String
  phone        String
  email        String?
  address      String?
  notes        String?
  loyaltyPoints Int     @default(0) @map("loyalty_points")
  totalSpent   Float    @default(0) @map("total_spent")
  ordersCount  Int      @default(0) @map("orders_count")
  lastOrderAt  DateTime? @map("last_order_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phone])
  @@map("customers")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("PROFESSIONAL") // ADMIN, PROFESSIONAL
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("users")
}

model WppInstance {
  id           String   @id @default(cuid())
  tenantId     String   @unique @map("tenant_id")
  instanceName String   @map("instance_name")
  phone        String?
  status       String   @default("not_configured") // not_configured, disconnected, qr_pending, connecting, connected
  qrCode       String?  @map("qr_code")
  isActive     Boolean  @default(false) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("wpp_instances")
}

model WppBotConfig {
  id               String   @id @default(cuid())
  tenantId         String   @unique @map("tenant_id")
  botEnabled       Boolean  @default(false) @map("bot_enabled")
  autoReplyEnabled Boolean  @default(true) @map("auto_reply_enabled")
  sendOrderCreated Boolean  @default(true) @map("send_order_created")
  sendStatusUpdates Boolean @default(true) @map("send_status_updates")
  welcomeMessage   String?  @map("welcome_message")
  isPaused         Boolean  @default(false) @map("is_paused")
  startTime        String?  @map("start_time") // HH:mm
  endTime          String?  @map("end_time")   // HH:mm
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("wpp_bot_configs")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  categoryId  String   @map("category_id")
  tenantId    String   @map("tenant_id")
  available   Boolean  @default(true)
  pdvOnly     Boolean  @default(false) @map("pdv_only")
  autoDisableWhenOutOfStock Boolean @default(false) @map("auto_disable_when_out_of_stock")
  createdAt   DateTime @default(now()) @map("created_at")
  inventoryItemId String? @map("inventory_item_id")

  category  Category    @relation(fields: [categoryId], references: [id])
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  variants  ProductVariant[]
  items     OrderItem[]

  @@map("products")
}

model ProductVariant {
  id          String @id @default(cuid())
  productId   String @map("product_id")
  name        String // e.g. "300ml", "500ml", "Inteira", "Meia"
  description String?
  price       Float
  inventoryItemId String? @map("inventory_item_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@map("product_variants")
}

model Order {
  id           String   @id @default(cuid())
  customerName String   @map("customer_name")
  customerPhone String  @map("customer_phone")
  address      String?
  status       String   @default("PENDING") // PENDING, PREPARING, SHIPPED, DELIVERED, CANCELLED
  orderType    String   @default("DELIVERY") @map("order_type")
  tableId      String?  @map("table_id")
  paymentMethod String  @default("CASH") @map("payment_method")
  paymentDetail String? @map("payment_detail") @db.Text
  discount     Float?   @default(0)
  discountType String?  @map("discount_type") // PERCENT, FIXED
  notes        String?  @db.Text
  operatorName String?  @map("operator_name")
  customerId   String?  @map("customer_id")
  total        Float
  tenantId     String   @map("tenant_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  items  OrderItem[]

  @@map("orders")
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String  @map("order_id")
  productId        String  @map("product_id")
  productVariantId String? @map("product_variant_id")
  quantity         Int
  price            Float
  notes            String? // User observations (remover cebola, etc)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Feature {
  id          String   @id @default(cuid())
  key         String?
  title       String
  description String
  priority    String?
  category    String?
  assignedTo  String?
  type        String
  tags        Json?
  points      Int      @default(0)
  deadline    DateTime?
  activities  String?  @db.Text
  isValidated Int?     @default(0)
  validatedBy String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("features")
}
