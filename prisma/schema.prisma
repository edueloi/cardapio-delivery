generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  whatsapp    String?
  address     String?
  isOpen        Boolean  @default(true) @map("is_open")
  scheduleMode  Boolean  @default(false) @map("schedule_mode")
  scheduleType  String   @default("CLIENT_CHOOSES") @map("schedule_type") // CLIENT_CHOOSES | OWNER_DEFINES
  scheduleDays  String?  @map("schedule_days") @db.Text // JSON: ScheduleDay[]
  scheduleNotes String?  @map("schedule_notes") @db.Text
  orderMode     String   @default("DELIVERY_ONLY") @map("order_mode") // DELIVERY_ONLY | PREORDER_ONLY | BOTH
  businessHours String? @map("business_hours") @db.Text // JSON: { mon: {open:"08:00",close:"22:00",enabled:true}, ... }
  deliveryConfig String? @map("delivery_config") @db.Text // JSON: DeliveryConfig
  paymentMethods String? @map("payment_methods") @db.Text // JSON: PaymentConfig
  stoneConfig    String? @map("stone_config") @db.Text // JSON: StoneConfig
  fiscalConfig   String? @map("fiscal_config") @db.LongText // JSON: FiscalConfig (CNPJ, IE, CSC, cert A1, série, ambiente)
  loyaltyConfig  String? @map("loyalty_config") @db.Text // JSON: LoyaltyConfig (pontos por real, mínimo pra resgate, etc)
  ifoodConfig    String? @map("ifood_config") @db.Text // JSON: IfoodConfig (merchantId, accessToken, refreshToken, tokenExpiresAt, status, autoAccept — client_id/secret são globais, em SystemConfig)
  displayPanelConfig String? @map("display_panel_config") @db.Text // JSON: DisplayPanelConfig (quais tipos de pedido aparecem no Painel TV)
  waiterNotifyOnReady Boolean @default(true) @map("waiter_notify_on_ready") // avisa o garçom quando a cozinha marca a comanda como pronta pra servir
  kitchenPasswordHash String? @map("kitchen_password_hash") // senha simples do painel de cozinha (/cozinha/:slug), sem conta de usuário
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users      User[]
  memberships TenantMembership[]
  categories Category[]
  products   Product[]
  orders     Order[]
  cashRegisters CashRegister[]
  restaurantTables RestaurantTable[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  productionRecipes   ProductionRecipe[]
  productionRuns      ProductionRun[]
  wppInstance WppInstance?
  wppBotConfig WppBotConfig?
  customers   Customer[]
  promotions  Promotion[]
  suppliers   Supplier[]
  condominiums CondominiumTenant[]
  financialEntries FinancialEntry[]
  recurringEntries RecurringEntry[]
  kitchenSessions  KitchenSession[]
  kitchenStaff     KitchenStaff[]
  kitchenAccessRequests KitchenAccessRequest[]
  wppMessageLogs   WppMessageLog[]
  inviteTokens     InviteToken[]

  @@map("tenants")
}

// Configuração global do sistema (não por tenant) — ex: credenciais de desenvolvedor
// da integração iFood (client_id/secret da aplicação BoxSys, editável só por Super Admin).
model SystemConfig {
  key       String   @id
  value     String?  @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

model Account {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String   @map("password_hash")
  isSuperAdmin   Boolean  @default(false) @map("is_super_admin")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  memberships        TenantMembership[]
  sessions           AuthSession[]
  inviteTokens       InviteToken[]
  subscriptions      Subscription[]
  passwordResetTokens PasswordResetToken[]

  @@map("accounts")
}

model SubscriptionPlan {
  id                      String   @id @default(cuid())
  name                    String
  description             String?  @db.Text
  price                   Float    @default(0)
  durationDays            Int      @default(30) @map("duration_days")
  features                String?  @db.Text
  isActive                Boolean  @default(true) @map("is_active")
  color                   String?  @default("#C9A227")
  defaultStaffPermissions String?  @db.Text @map("default_staff_permissions") // JSON: string[] tab ids
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  planId      String   @map("plan_id")
  status      String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED, TRIAL
  startsAt    DateTime @map("starts_at")
  expiresAt   DateTime @map("expires_at")
  pricePaid   Float    @default(0) @map("price_paid")
  notes       String?  @db.Text
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model TenantMembership {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  tenantId    String   @map("tenant_id")
  role        String   @default("OWNER") // OWNER, ADMIN, STAFF
  name        String?  // display name override (e.g. "João – Caixa")
  permissions String?  @db.Text // JSON: string[] of allowed tab ids. null = all allowed (OWNER)
  createdAt   DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([accountId, tenantId])
  @@map("tenant_memberships")
}

model AuthSession {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

// Funcionário com acesso ao painel de cozinha — nome + usuário + senha próprios,
// cadastrado pelo dono (direto ou aprovando um KitchenAccessRequest). Convive com a
// senha única do tenant (kitchenPasswordHash): quem souber a senha da loja entra
// como sessão anônima; quem tiver usuário aqui entra identificado (nome aparece na
// tela para outros da equipe saberem quem está). username é único no sistema
// inteiro (não só por loja) — é ele que permite logar em cozinha.boxsys.com.br
// sem informar o slug da loja na URL.
model KitchenStaff {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String
  username     String   @unique
  passwordHash String   @map("password_hash")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions KitchenSession[]

  @@unique([tenantId, name])
  @@map("kitchen_staff")
}

// Pedido de acesso à cozinha feito pelo próprio funcionário em cozinha.boxsys.com.br,
// antes de ter usuário — informa nome, usuário desejado, a loja onde trabalha (por
// nome/slug digitado) e um contato. Fica pendente até o dono aprovar (definindo a
// senha) ou rejeitar pelo painel admin (aba Equipe da Cozinha).
model KitchenAccessRequest {
  id          String    @id @default(cuid())
  name        String
  username    String
  storeQuery  String    @map("store_query") // texto digitado pelo funcionário para identificar a loja
  contact     String?
  tenantId    String?   @map("tenant_id")   // preenchido se a busca encontrou uma loja com esse nome/slug
  status      String    @default("PENDING") @map("status") // PENDING, APPROVED, REJECTED
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("kitchen_access_requests")
}

// Sessão do painel de cozinha (/cozinha/:slug) — login por senha simples da loja
// (kitchenStaffId nulo, sessão anônima) ou por funcionário cadastrado (KitchenStaff).
// Pensado para um tablet/TV fixo, por isso expira em 1 ano (na prática "sempre
// conectado"; só sai se deslogar manualmente ou limpar o navegador).
model KitchenSession {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  kitchenStaffId String?  @map("kitchen_staff_id")
  token          String   @unique
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kitchenStaff KitchenStaff? @relation(fields: [kitchenStaffId], references: [id], onDelete: Cascade)

  @@map("kitchen_sessions")
}

model InviteToken {
  id          String   @id @default(cuid())
  token       String   @unique
  createdById String   @map("created_by_id")
  usedAt      DateTime? @map("used_at")
  usedByEmail String?  @map("used_by_email")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  note        String?  // observação opcional (ex: "Para João da pizzaria X")

  // Preenchidos apenas em convites de equipe (dono convidando alguém para um tenant já existente).
  // Quando tenantId é null, é um convite genérico de super admin (cria conta, sem loja vinculada).
  tenantId    String?  @map("tenant_id")
  targetEmail String?  @map("target_email") // e-mail para o qual o convite de equipe foi enviado
  role        String?  // ADMIN | STAFF — cargo a ser aplicado na TenantMembership criada na aceitação
  permissions String?  @db.Text // JSON: string[] tab ids, ou null = acesso total
  memberName  String?  @map("member_name") // apelido a ser gravado na TenantMembership (ex: "João — Caixa")

  createdBy Account @relation(fields: [createdById], references: [id], onDelete: Cascade)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("invite_tokens")
}

model InventoryCategory {
  id        String   @id @default(cuid())
  name      String
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  items  InventoryItem[]

  @@map("inventory_categories")
}

model InventoryItem {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  categoryId      String?   @map("category_id")
  code            String?   // Product code
  name            String
  brand           String?   // Brand
  purchasePrice   Float?    @map("purchase_price")
  sellingPrice    Float?    @map("selling_price")
  quantity        Float     @default(0)
  minStock        Float?    @map("min_stock")
  unit            String?   // kg, g, un, cm, ml
  weight          String?   // Specific weight/measure e.g. "500g"
  usage           String    @default("SALE") @map("usage") // SALE (external), INTERNAL
  // Conversão inteligente: comprei X "purchase_unit", cada um tem "purchase_qty" de "stock_unit"
  // Ex: comprei 10 "un" de óleo, cada uma tem 1000 "ml" → estoque total = 10000 ml
  purchaseUnit    String?   @map("purchase_unit") // unidade de compra: "un", "cx", "fardo"
  purchaseQty     Float?    @map("purchase_qty")  // conteúdo por unidade: ex 1000 (ml por garrafa)
  stockUnit       String?   @map("stock_unit")    // unidade granular: "ml", "g", "un"
  purchaseDate    DateTime? @map("purchase_date")
  expirationDate  DateTime? @map("expiration_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  category InventoryCategory? @relation(fields: [categoryId], references: [id])
  movements StockMovement[]
  products  Product[]
  variants  ProductVariant[]
  supplierItems SupplierInventoryItem[]

  @@map("inventory_items")
}

model Supplier {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String
  cpfCnpj      String?  @map("cpf_cnpj")
  type         String   @default("OUTROS") @map("type") // ALIMENTICIO, BEBIDAS, EMBALAGENS, LIMPEZA, EQUIPAMENTOS, OUTROS
  phone        String?
  email        String?
  cep          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  country      String?  @default("Brasil")
  notes        String?  @db.Text
  isFavorite   Boolean  @default(false) @map("is_favorite")
  isActive     Boolean  @default(true)  @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItems SupplierInventoryItem[]
  catalogItems   SupplierCatalogItem[]

  @@map("suppliers")
}

model SupplierCatalogItem {
  id         String   @id @default(cuid())
  supplierId String   @map("supplier_id")
  name       String
  unit       String?
  price      Float?
  notes      String?  @db.Text
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt      @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_catalog_items")
}

model SupplierInventoryItem {
  id             String @id @default(cuid())
  supplierId     String @map("supplier_id")
  inventoryItemId String @map("inventory_item_id")

  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([supplierId, inventoryItemId])
  @@map("supplier_inventory_items")
}

model StockMovement {
  id          String   @id @default(cuid())
  itemId      String   @map("item_id")
  type        String   // IN, OUT
  quantity    Float
  reason      String?  // SALE, PURCHASE, EXPIRATION, LOSS, MANUAL
  orderId     String?  @map("order_id")
  createdAt   DateTime @default(now()) @map("created_at")

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

model CashRegister {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  openedAt        DateTime  @default(now()) @map("opened_at")
  closedAt        DateTime? @map("closed_at")
  openingBalance  Float     @map("opening_balance")
  closingBalance  Float?    @map("closing_balance")
  expectedBalance Float?    @map("expected_balance")
  status          String    @default("OPEN") // OPEN, CLOSED
  notes           String?
  operatorName    String?   @map("operator_name")

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  movements CashMovement[]

  @@map("cash_registers")
}

model CashMovement {
  id             String   @id @default(cuid())
  cashRegisterId String   @map("cash_register_id")
  tenantId       String   @map("tenant_id")
  type           String   // SANGRIA, SUPRIMENTO, PAYMENT_CASH, PAYMENT_PIX, PAYMENT_CREDIT, PAYMENT_DEBIT, PAYMENT_VR
  amount         Float
  description    String?
  orderId        String?  @map("order_id")
  operatorName   String?  @map("operator_name")
  createdAt      DateTime @default(now()) @map("created_at")

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)

  @@map("cash_movements")
}

model FinancialEntry {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  type        String   // INCOME, EXPENSE
  category    String   // "Delivery", "iFood", "Fornecedores", "Aluguel", etc
  description String
  amount      Float
  date        DateTime @db.Date
  notes       String?  @db.Text
  source      String   @default("MANUAL") // MANUAL, IFOOD — origem do lançamento
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Gerado a partir de uma recorrência (água/luz, aluguel, etc)
  recurringEntryId String?   @map("recurring_entry_id")
  dueDate          DateTime? @db.Date @map("due_date")     // vencimento — pode ser diferente de "date" (data efetiva de pagamento)
  paidAt           DateTime? @map("paid_at")
  status           String    @default("PAID") @map("status") // PENDING (recorrência variável aguardando valor/pagamento) | PAID
  installmentNumber Int?     @map("installment_number")   // parcela atual (1-based), quando a recorrência tem parcelas
  installmentsTotal Int?     @map("installments_total")    // total de parcelas, snapshot no momento da geração
  baseAmount        Float?   @map("base_amount")           // valor original antes de juros (quando lateFeeApplied > 0)
  lateFeeApplied    Float?   @map("late_fee_applied")      // juros calculado e somado ao amount por atraso

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recurringEntry  RecurringEntry? @relation(fields: [recurringEntryId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
  @@index([recurringEntryId])
  @@map("financial_entries")
}

// Regra de recorrência financeira: gastos/receitas que se repetem todo mês
// (água, luz, aluguel, sistema, etc). Pode ser FIXED (valor constante, gerado
// automaticamente já como PAID) ou VARIABLE (sistema cria o lançamento do mês
// como PENDING, com amount null, esperando o usuário preencher e confirmar).
model RecurringEntry {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  type         String   // INCOME, EXPENSE
  category     String
  description  String
  frequency    String   @default("FIXED") // FIXED | VARIABLE
  amount       Float?   // obrigatório quando FIXED; null quando VARIABLE (preenchido lançamento a lançamento)
  dueDay       Int      @map("due_day")   // dia do mês em que vence (1-28, para evitar meses sem o dia)
  startDate    DateTime @db.Date @map("start_date")
  endDate      DateTime? @db.Date @map("end_date") // null = sem prazo definido

  // Parcelamento — quando definido, a recorrência para de gerar novos lançamentos após atingir o total
  installmentsTotal Int? @map("installments_total") // null = recorrência sem prazo de parcelas (contínua)

  // Juros por atraso — aplicado quando o lançamento gerado passa do dueDate ainda em PENDING/sem pagamento
  lateFeeEnabled  Boolean @default(false) @map("late_fee_enabled")
  lateFeeRate     Float?  @map("late_fee_rate")     // taxa percentual (ex: 1 = 1%)
  lateFeeInterval String? @map("late_fee_interval") // DAILY | MONTHLY | YEARLY — periodicidade da taxa acima

  active      Boolean  @default(true)
  notes       String?  @db.Text
  lastGeneratedFor String? @map("last_generated_for") // "YYYY-MM" do último mês em que gerou lançamento — controla idempotência
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries FinancialEntry[]

  @@index([tenantId, active])
  @@map("recurring_entries")
}

model Customer {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String
  phone        String
  email        String?
  birthday     DateTime? @db.Date // opcional — usado para promoções de aniversário
  address      String?  // legado — endereço único antigo, mantido por compatibilidade
  notes        String?
  loyaltyPoints Int     @default(0) @map("loyalty_points")
  totalSpent   Float    @default(0) @map("total_spent")
  ordersCount  Int      @default(0) @map("orders_count")
  lastOrderAt  DateTime? @map("last_order_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]

  @@unique([tenantId, phone])
  @@map("customers")
}

model CustomerAddress {
  id           String   @id @default(cuid())
  customerId   String   @map("customer_id")
  label        String?  // ex: "Casa", "Trabalho" — opcional
  cep          String?
  street       String
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("PROFESSIONAL") // ADMIN, PROFESSIONAL
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("users")
}

model WppInstance {
  id           String   @id @default(cuid())
  tenantId     String   @unique @map("tenant_id")
  instanceName String   @map("instance_name")
  phone        String?
  status       String   @default("not_configured") // not_configured, disconnected, qr_pending, connecting, connected
  qrCode       String?  @map("qr_code")
  isActive     Boolean  @default(false) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("wpp_instances")
}

model WppBotConfig {
  id               String   @id @default(cuid())
  tenantId         String   @unique @map("tenant_id")
  botEnabled       Boolean  @default(false) @map("bot_enabled")
  autoReplyEnabled Boolean  @default(true) @map("auto_reply_enabled")
  sendOrderCreated Boolean  @default(true) @map("send_order_created")
  sendStatusUpdates Boolean @default(true) @map("send_status_updates")
  sendLoyaltyPoints Boolean @default(true) @map("send_loyalty_points") // avisa cliente quando ganha pontos de fidelidade
  sendReceiptPdf   Boolean  @default(true) @map("send_receipt_pdf") // envia o recibo em PDF ao cliente quando o pedido é entregue
  sendLowStockAlert Boolean @default(false) @map("send_low_stock_alert") // avisa o dono quando item de estoque atinge o mínimo
  ownerAlertPhone  String?  @map("owner_alert_phone") // número que recebe alertas internos (novo pedido, estoque baixo) — se vazio, cai no whatsapp público do tenant
  welcomeMessage   String?  @map("welcome_message")
  isPaused         Boolean  @default(false) @map("is_paused")
  startTime        String?  @map("start_time") // HH:mm
  endTime          String?  @map("end_time")   // HH:mm
  preorderMessage  String?  @map("preorder_message") @db.Text // custom message for preorders; supports {nome}, {data}, {hora}, {total}
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("wpp_bot_configs")
}

// Histórico de mensagens enviadas pelo bot — auditoria simples do que foi mandado, pra quem e quando.
model WppMessageLog {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  toPhone   String   @map("to_phone")
  kind      String   // ORDER_CREATED, OWNER_ALERT, STATUS_UPDATE, LOYALTY_POINTS, LOW_STOCK, PREORDER, MANUAL_TEST, CONVERSATION, RECEIPT_PDF
  preview   String   @db.Text // primeiras linhas da mensagem, para exibição na lista
  sentAt    DateTime @default(now()) @map("sent_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sentAt])
  @@map("wpp_message_logs")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  tenantId  String   @map("tenant_id")
  sortOrder Int      @default(0) @map("sort_order")
  ifoodCategoryId String? @map("ifood_category_id") // ID da categoria correspondente no catálogo iFood
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  categoryId  String   @map("category_id")
  tenantId    String   @map("tenant_id")
  available   Boolean  @default(true)
  pdvOnly     Boolean  @default(false) @map("pdv_only")
  kitchenPrint Boolean @default(false) @map("kitchen_print") // true = vai para o painel de cozinha — dono marca manualmente o que precisa de preparo
  sortOrder   Int      @default(0) @map("sort_order")
  autoDisableWhenOutOfStock Boolean @default(false) @map("auto_disable_when_out_of_stock")
  extras      String?  @db.Text // JSON: ProductExtra[]
  scheduleRule String? @map("schedule_rule") @db.Text // JSON: ProductScheduleRule
  // Dados fiscais NFC-e
  ncm         String?  // Nomenclatura Comum do Mercosul (8 dígitos)
  cfop        String?  // Código Fiscal de Operações (ex: "5102")
  csosn       String?  // CSOSN Simples Nacional (ex: "400") ou CST
  unitCom     String?  @map("unit_com") @default("UN") // Unidade comercial: UN, KG, L, CX
  origem      Int      @default(0) // 0=Nacional, 1=Estrangeira importação direta
  aliqIcms    Float    @default(0) @map("aliq_icms") // Alíquota ICMS %
  createdAt   DateTime @default(now()) @map("created_at")
  inventoryItemId String? @map("inventory_item_id")
  recipeId        String? @map("recipe_id")
  ifoodItemId     String? @map("ifood_item_id")   // ID do item correspondente no catálogo iFood
  ifoodSyncedAt   DateTime? @map("ifood_synced_at") // última sincronização bem-sucedida com o iFood

  category  Category    @relation(fields: [categoryId], references: [id])
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  recipe    ProductionRecipe? @relation("ProductLinkedRecipe", fields: [recipeId], references: [id], onDelete: SetNull)
  variants  ProductVariant[]
  items     OrderItem[]
  promotions Promotion[]
  productionRecipes ProductionRecipe[] @relation("RecipeLinkedProduct")

  @@map("products")
}

model ProductVariant {
  id          String @id @default(cuid())
  productId   String @map("product_id")
  name        String // e.g. "300ml", "500ml", "Inteira", "Meia"
  description String?
  price       Float
  imageUrl    String? @map("image_url")
  inventoryItemId String? @map("inventory_item_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  orderItems OrderItem[]

  @@map("product_variants")
}

model Order {
  id           String   @id @default(cuid())
  customerName String   @map("customer_name")
  customerPhone String  @map("customer_phone")
  address      String?
  status       String   @default("PENDING") // PENDING, PREPARING, SHIPPED, AWAITING_PAYMENT (mesa/balcão fechado, aguardando faturar no PDV), DELIVERED, CANCELLED
  orderType    String   @default("DELIVERY") @map("order_type")
  source          String  @default("DIRECT") @map("source") // DIRECT (PDV/cardápio/whatsapp), IFOOD, etc — origem do pedido
  externalOrderId String? @map("external_order_id") // ID do pedido no sistema de origem (ex: id do pedido no iFood)
  tableId      String?  @map("table_id")
  counterTicketNumber Int? @map("counter_ticket_number") // senha sequencial diária — só para pedidos de balcão (tableId nulo, orderType DINE_IN)
  paymentMethod String  @default("CASH") @map("payment_method")
  paymentDetail String? @map("payment_detail") @db.Text
  discount     Float?   @default(0)
  discountType String?  @map("discount_type") // PERCENT, FIXED
  notes         String?  @db.Text
  operatorName  String?  @map("operator_name")
  customerId    String?  @map("customer_id")
  scheduledDate DateTime? @map("scheduled_date") @db.Date
  scheduledTime  String?   @map("scheduled_time") // HH:mm
  stoneChargeId  String?   @map("stone_charge_id")
  // NFC-e
  nfceKey       String?   @map("nfce_key")      // chave de acesso 44 dígitos
  nfceStatus    String?   @map("nfce_status")   // PENDING | AUTHORIZED | REJECTED | CANCELLED
  nfceProtocol  String?   @map("nfce_protocol") // protocolo SEFAZ
  nfceXml       String?   @map("nfce_xml") @db.LongText // XML autorizado + URL DANFE (JSON)
  nfceNumber    Int?      @map("nfce_number")   // número sequencial da NFC-e
  customerCpf   String?   @map("customer_cpf")  // CPF do consumidor — Nota Fiscal Paulista
  // Taxa de maquininha
  feeAmount           Float?   @map("fee_amount")             // valor da taxa cobrada pela adquirente (custo)
  feePercent          Float?   @map("fee_percent")             // percentual aplicado (bandeira + parcelas)
  feePassedToCustomer Boolean  @default(false) @map("fee_passed_to_customer") // se true, feeAmount já está somado em total
  // Taxa de serviço (ex: 10% da mesa) — opcional, o cliente pode recusar no pagamento
  serviceFeeAmount  Float?  @map("service_fee_amount")  // valor da taxa de serviço aplicada neste pedido
  serviceFeePercent Float?  @map("service_fee_percent") // percentual aplicado (snapshot da config no momento do pedido)
  total          Float
  tenantId      String   @map("tenant_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  items  OrderItem[]

  @@index([tenantId, source, externalOrderId])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String  @map("order_id")
  productId        String  @map("product_id")
  productVariantId String? @map("product_variant_id")
  quantity         Int
  price            Float
  notes            String? // User observations (remover cebola, etc)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@map("order_items")
}

model Promotion {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  title       String
  description String?  @db.Text
  imageUrl    String?  @map("image_url")
  linkProductId String? @map("link_product_id")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [linkProductId], references: [id], onDelete: SetNull)

  @@map("promotions")
}

model ProductionRecipe {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  productId      String?  @map("product_id")
  name           String
  description    String?  @db.Text
  outputQuantity Float    @default(1) @map("output_quantity")
  outputUnit     String   @default("un") @map("output_unit")
  instructions   String?  @db.Text
  ingredients    String   @db.LongText
  overheads      String?  @db.LongText
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product? @relation("RecipeLinkedProduct", fields: [productId], references: [id], onDelete: SetNull)
  linkedByProducts Product[] @relation("ProductLinkedRecipe")
  runs    ProductionRun[]

  @@map("production_recipes")
}

model ProductionRun {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  recipeId            String?  @map("recipe_id")
  recipeName          String   @map("recipe_name")
  batchCode           String   @map("batch_code")
  quantityProduced    Float    @default(1) @map("quantity_produced")
  unit                String   @default("un")
  notes               String?  @db.Text
  createdByName       String?  @map("created_by_name")
  totalIngredientCost Float    @default(0) @map("total_ingredient_cost")
  totalOverheadCost   Float    @default(0) @map("total_overhead_cost")
  totalCost           Float    @default(0) @map("total_cost")
  costPerOutput       Float    @default(0) @map("cost_per_output")
  ingredientsSnapshot String   @map("ingredients_snapshot") @db.LongText
  overheadsSnapshot   String?  @map("overheads_snapshot") @db.LongText
  outputSnapshot      String?  @map("output_snapshot") @db.LongText
  createdAt           DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipe ProductionRecipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@map("production_runs")
}

model Condominium {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?  @db.Text
  logoUrl      String?  @map("logo_url")
  bannerUrl    String?  @map("banner_url")
  primaryColor String?  @map("primary_color") @default("#C9A227")
  address      String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenants CondominiumTenant[]

  @@map("condominiums")
}

model CondominiumTenant {
  id             String   @id @default(cuid())
  condominiumId  String   @map("condominium_id")
  tenantId       String   @map("tenant_id")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  condominium Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([condominiumId, tenantId])
  @@map("condominium_tenants")
}

model Feature {
  id          String   @id @default(cuid())
  key         String?
  title       String
  description String
  priority    String?
  category    String?
  assignedTo  String?
  type        String
  tags        Json?
  points      Int      @default(0)
  deadline    DateTime?
  activities  String?  @db.Text
  isValidated Int?     @default(0)
  validatedBy String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("features")
}

// Mesa cadastrada pelo estabelecimento — usada pelo PDV/garçom para abrir uma mesa nova
// sem precisar digitar o número livremente. label = "1", "2", "VIP", etc.
model RestaurantTable {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, label])
  @@map("restaurant_tables")
}
